# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Continuous Native Generation: native projects are generated, never committed
/ios
/android
.kotlin/

# Gradle caches, and the build output of the local native modules (their sources stay tracked)
.gradle/
/modules/*/android/build/

# Fastlane and Bundler output (the Gemfile and its lockfile are committed)
/build/
/vendor/bundle/
/.bundle/
fastlane/report.xml
fastlane/README.md
fastlane/test_output/

# Native signing material
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*.orig.*

# Environment files
.env
.env.*
!.env.example

# Tests and coverage
coverage/
*.lcov

# TypeScript
*.tsbuildinfo

# Metro
.metro-health-check*

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# OS and editors
.DS_Store
.idea/
.vscode/
*.swp
