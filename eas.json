{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BOARDROOM_ADAPTERS": "mock"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BOARDROOM_ADAPTERS": "mock"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BOARDROOM_ADAPTERS": "http",
        "EXPO_PUBLIC_BOARDROOM_API_BASE_URL": "https://api.replace-me.example.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "0000000000"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
