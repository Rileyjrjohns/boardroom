# Copy this file to `.env` to change a setting. `.env` is git-ignored; this file is not.
#
# Only variables whose name starts with EXPO_PUBLIC_ reach the app. Expo reads them when Metro
# starts, so restart it (npm start -- --clear) after changing one. Never put a secret here: whatever
# starts with EXPO_PUBLIC_ is readable in the bundle.

# How the app is wired (see "Composition root" in the README).
#   mock  The in-memory adapters and a simulated server. Needs no network.
#   http  The real adapters: the HTTP API, the encrypted SQLite database, the secure storage. Needs
#         EXPO_PUBLIC_BOARDROOM_API_BASE_URL below.
# A missing or empty value means mock in a development build, and is an error in any other build
# (missingAdaptersSetting): a release build must be told what it talks to. Any other value is
# refused at start.
EXPO_PUBLIC_BOARDROOM_ADAPTERS=mock

# Where the API is, for the http adapters (see "Running against the mock API" in the README). It is
# an https address, or an http one for this machine only (localhost, 127.0.0.1, [::1] and 10.0.2.2,
# which is how the Android emulator reaches the computer it runs on). A development build also
# accepts http for another computer of the network, to reach `npm run mock:api` from a phone: use
# its address, such as http://192.168.1.20:4000. Not used by mock.
EXPO_PUBLIC_BOARDROOM_API_BASE_URL=http://localhost:4000
